---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Ahmed Samir',
  description = 'AI Engineer in Muscat. Milestones, research and projects.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>
      <a href="/">Ahmed Samir</a> · Muscat, Oman
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #faf9f6;
    --surface: #ffffff;
    --text: #1b1b1a;
    --muted: #6b6a66;
    --line: #e6e3dc;
    --accent: #0f6e56;
    --accent-soft: #e3f1ec;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121312;
      --surface: #1a1c1b;
      --text: #ecebe7;
      --muted: #9a9993;
      --line: #2b2e2c;
      --accent: #5fcfa8;
      --accent-soft: #1d2f29;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.65 'Instrument Sans', system-ui, sans-serif;
  }
  main, footer { max-width: 720px; margin: 0 auto; padding: 0 16px; }
  footer { padding-block: 48px; color: var(--muted); font-size: 14px; }
  a { color: var(--accent); text-underline-offset: 3px; }
  footer a { color: inherit; }
  h1, h2, h3 { line-height: 1.25; }
  .serif { font-family: Newsreader, Georgia, serif; font-weight: 500; }
</style>
